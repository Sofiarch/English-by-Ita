# Supabase (safe in the browser — the VITE_ prefix exposes them to the site)
# Dashboard → Connect, or Project Settings → API Keys
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="sb_publishable_..."

# Gemini (server only — never add a VITE_ prefix to this)
# https://aistudio.google.com → Get API key
GEMINI_API_KEY="AIza..."

# Optional model overrides
# GEMINI_MODEL="gemini-3.6-flash"
# GEMINI_FAST_MODEL="gemini-3.1-flash-lite"

# Optional: port for the dev/prod server (default 3000)
# PORT=3000
